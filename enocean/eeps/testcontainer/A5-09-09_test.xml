<?xml version="1.0" encoding="utf-8"?>
<ProfileCertification xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./Certification_EEP.xsd" schemaVersion="0.9">
  <EEP rorg="0xA5" func="0x09" type="0x09">
    <TestCase>
      <Name>Teach-in Test</Name>
      <Test>
        <Name>Unidirectional Teach-in Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0x0">0x24</Byte>
              <Byte order="1" ignoremask="0x07">0x48</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0x00">0x80</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>LRN Bit</Type>
                <Value>0</Value>
              </Data>
              <Data>
                <Type>RORG</Type>
                <Value>165</Value>
              </Data>
              <Data>
                <Type>FUNC</Type>
                <Value>9</Value>
              </Data>
              <Data>
                <Type>TYPE</Type>
                <Value>9</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>CO2 Tests</Name>
      <Test>
        <Name>Min CO2 Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0x00">0x00</Byte>
              <Byte order="3" ignoremask="0xF7">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>CO2</Shortcut>
                <Type>CO2</Type>
                <Value>0</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Max CO2 Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0x00">0xFF</Byte>
              <Byte order="3" ignoremask="0xF7">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>CO2</Shortcut>
                <Type>CO2</Type>
                <Value>2000</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Mid CO2 Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0x00">0x7F</Byte>
              <Byte order="3" ignoremask="0xF7">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>CO2</Shortcut>
                <Type>CO2</Type>
                <Value>1000</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>Power Failure detection Enum Test</Name>
      <Test>
        <Name>Power Failure detection: Power failure not detected</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xF3">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>PFD</Shortcut>
                <Type>Power failure not detected</Type>
                <Value>0</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Power Failure detection: Power failure detected</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xF3">0x0C</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>PFD</Shortcut>
                <Type>Power failure detected</Type>
                <Value>1</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>unusedFieldTest</Name>
      <Test>
        <Name>unused field test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0x00">0x00</Byte>
              <Byte order="1" ignoremask="0x00">0x00</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xFF">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
  </EEP>
</ProfileCertification>