              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xF7">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>SVC</Shortcut>
                <Type>Supply voltage</Type>
                <Value>0</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Max Supply voltage Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0x00">0xFA</Byte>
