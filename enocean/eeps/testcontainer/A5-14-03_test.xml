    <TestCase>
      <Name>Teach-in Test</Name>
      <Test>
        <Name>Unidirectional Teach-in Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0x0">0x50</Byte>
              <Byte order="1" ignoremask="0x07">0x18</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0x00">0x80</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>LRN Bit</Type>
                <Value>0</Value>
              </Data>
              <Data>
                <Type>RORG</Type>
                <Value>165</Value>
              </Data>
              <Data>
                <Type>FUNC</Type>
                <Value>20</Value>
              </Data>
              <Data>
                <Type>TYPE</Type>
                <Value>3</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>Supply voltage Tests</Name>
