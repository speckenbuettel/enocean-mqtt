<?xml version="1.0" encoding="utf-8"?>
<ProfileCertification
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./Certification_EEP.xsd" schemaVersion="0.9">
	<EEP rorg="0xD2" func="0x06" type="0x10">
		<TestCase>
			<Name>Teach-in Test</Name>
			<Test>
				<Name>Smart Ack Teach-in</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xC6" length="15">
							<!--SM_LRN_REQ-->
							<Byte order="0">0xF8</Byte>
							<Byte order="1" ignoremask="0xFF">0x00</Byte>
							<Byte order="2" ignoremask="0x00">0xD2</Byte>
							<Byte order="3" ignoremask="0x00">0x06</Byte>
							<Byte order="4" ignoremask="0x00">0x10</Byte>
							<Byte order="5" ignoremask="0xFF">0x00</Byte>
							<Byte order="6" ignoremask="0xFF">0x00</Byte>
							<Byte order="7" ignoremask="0xFF">0x00</Byte>
							<Byte order="8" ignoremask="0xFF">0x00</Byte>
							<Byte order="9" ignoremask="0xFF">0x00</Byte>
							<Byte order="10" ignoremask="0xFF">0x00</Byte>
							<Byte order="11" ignoremask="0xFF">0x00</Byte>
							<Byte order="12" ignoremask="0xFF">0x00</Byte>
							<Byte order="13" ignoremask="0xFF">0x00</Byte>
							<Byte order="14" ignoremask="0xFF">0x00</Byte>
							<Byte order="15" ignoremask="0xFF">0x00</Byte>
						</Telegram>
						<RealData>
							<Data>
								<Type>Request Code</Type>
								<Value>31</Value>
							</Data>
							<Data>
								<Type>RORG</Type>
								<Value>210</Value>
							</Data>
							<Data>
								<Type>FUNC</Type>
								<Value>6</Value>
							</Data>
							<Data>
								<Type>TYPE</Type>
								<Value>16</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
			<Test>
				<Name>SM_REC 0xA7</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xA7" length="6">
							<!--SM_REC-->
							<Byte order="0" ignoremask="0x7F">0x00</Byte>
							<Byte order="1" ignoremask="0xFF">0x00</Byte>
							<Byte order="2" ignoremask="0xFF">0x00</Byte>
							<Byte order="3" ignoremask="0xFF">0x00</Byte>
							<Byte order="4" ignoremask="0xFF">0x00</Byte>
							<Byte order="5" ignoremask="0xFF">0x00</Byte>
							<Byte order="6" ignoremask="0xFF">0x00</Byte>
						</Telegram>
						<RealData>
							<Data>
								<Type>Reclaim Type</Type>
								<Value>0</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
		</TestCase>
		<TestCase>
			<Name>Pre-alarm status Enum Test</Name>
			<Test>
				<Name>Pre-alarm occured</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0x7F">0x80</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>PA</ShortCut>
								<Type>Pre-alarm</Type>
								<Value>1</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
			<Test>
				<Name>No Pre-alarm</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0x7F">0x00</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>PA</ShortCut>
								<Type>Pre-alarm</Type>
								<Value>0</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
		</TestCase>
		<TestCase>
			<Name>Alarm status Enum Test</Name>
			<Test>
				<Name>Alarm occured</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0xBF">0x40</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>AL</ShortCut>
								<Type>Alarm</Type>
								<Value>1</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
			<Test>
				<Name>No Alarm</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0xBF">0x00</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>AL</ShortCut>
								<Type>Alarm</Type>
								<Value>0</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
		</TestCase>
		<TestCase>
			<Name>Window contact status Enum Test</Name>
			<Test>
				<Name>Contact closed</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0xDF">0x20</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>CT</ShortCut>
								<Type>Windowcontact</Type>
								<Value>1</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
			<Test>
				<Name>Contact open</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0xDF">0x00</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>CT</ShortCut>
								<Type>Windowcontact</Type>
								<Value>0</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
		</TestCase>
		<TestCase>
			<Name>Pre-alarm enabled Enum Test</Name>
			<Test>
				<Name>Pre-alarm enabled</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0xEF">0x10</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>PAE</ShortCut>
								<Type>Pre-alarm monitoring</Type>
								<Value>1</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
			<Test>
				<Name>Pre-alarm enabled</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0xEF">0x00</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>PAE</ShortCut>
								<Type>Pre-alarm monitoring</Type>
								<Value>0</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
		</TestCase>
		<TestCase>
			<Name>State of the global alarm system Enum Test</Name>
			<Test>
				<Name>Enable alarm system</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0x7F">0x80</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>AL</ShortCut>
								<Type>Set Alert-Level</Type>
								<Value>1</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
			<Test>
				<Name>Disable alarm system</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0x7F">0x00</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>AL</ShortCut>
								<Type>Set Alert-Level</Type>
								<Value>0</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
		</TestCase>
		<TestCase>
			<Name>Pre-alarm monitoring Enum Test</Name>
			<Test>
				<Name>Per-alarm enable</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0xBF">0x40</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>PAE</ShortCut>
								<Type>Pre-alarm</Type>
								<Value>1</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
			<Test>
				<Name>Pre-alarm disable</Name>
				<Step>
					<DataSet>
						<Telegram rorg="0xD2" length="1">
							<Byte order="0" ignoremask="0xBF">0x00</Byte>
						</Telegram>
						<RealData>
							<Data>
								<ShortCut>PAE</ShortCut>
								<Type>Pre-alarm</Type>
								<Value>0</Value>
							</Data>
						</RealData>
					</DataSet>
				</Step>
			</Test>
		</TestCase>
    <TestCase>
        <Name>Unused Field Tests Sensor to Gateway</Name>
        <Test>
            <Name>Unused Field Test</Name>
            <Step>
                <DataSet>
                    <Telegram rorg="0xD2" length="1">
                        <Byte order="0" ignoremask="0xF0">0x00</Byte>
                    </Telegram>
                    <RealData>
                        <Data>
                            <ShortCut>ST</ShortCut>
                            <Type>test</Type>
                            <Value>0</Value>
                        </Data>
                    </RealData>
                </DataSet>
            </Step>
        </Test>
    </TestCase>
    <TestCase>
        <Name>Unused Field Tests Gateway to Sensor</Name>
        <Test>
            <Name>Unused Field Test</Name>
            <Step>
                <DataSet>
                    <Telegram rorg="0xD2" length="1">
                        <Byte order="0" ignoremask="0xB0">0x00</Byte>
                    </Telegram>
                    <RealData>
                        <Data>
                            <ShortCut>ST</ShortCut>
                            <Type>test</Type>
                            <Value>0</Value>
                        </Data>
                    </RealData>
                </DataSet>
            </Step>
        </Test>
    </TestCase>
  </EEP>
</ProfileCertification>