            <RealData>
              <Data>
                 <Shortcut>LRNB</Shortcut>
                <Type>LRN Bit</Type>
                <Value>0</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
