          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xF6">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>SVA</Shortcut>
                <Type>Supply voltage is not supported</Type>
                <Value>0</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Supply voltage availability: Supply voltage is supported</Name>
