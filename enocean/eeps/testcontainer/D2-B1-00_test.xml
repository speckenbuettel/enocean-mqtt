<?xml version="1.0" encoding="utf-8"?>
<ProfileCertification xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:noNamespaceSchemaLocation="./Certification_EEP.xsd"  schemaVersion="0.9">
 <EEP rorg="0xD2" func="0xB1" type="0x00">
   
  <TestCase>
   <Name>Channel number Test</Name>
   <Test>
    <Name>min channel number</Name>
    <Step>
     <Dataset>
      <Telegram rorg="0xD2" length="3">
        <Byte order="0" ignoremask="0x00">0x00</Byte>
        <Byte order="1" ignoremask="0xFF">0x00</Byte>
        <Byte order="2" ignoremask="0xFF">0x00</Byte>
      </Telegram>
      <RealData>
        <Data>
        <Shortcut>CHA</Shortcut>
        <Type>Channel</Type>
        <Value>0</Value>
       </Data>	  
      </RealData>
     </Dataset>
    </Step>
    </Test>
   <Test>
    <Name>midian channel number</Name>
    <Step>
     <Dataset>
      <Telegram rorg="0xD2" length="3">
        <Byte order="0" ignoremask="0x00">0x7F</Byte>
        <Byte order="1" ignoremask="0xFF">0x00</Byte>
        <Byte order="2" ignoremask="0xFF">0x00</Byte>
      </Telegram>
      <RealData>
        <Data>
        <Shortcut>CHA</Shortcut>
        <Type>Cannel</Type>
        <Value>127</Value>
       </Data>	   
      </RealData>
     </Dataset>
    </Step>
    </Test>
    <Test>
    <Name>max channel number</Name>
    <Step>
     <Dataset>
      <Telegram rorg="0xD2" length="3">
        <Byte order="0" ignoremask="0x00">0xFF</Byte>
        <Byte order="1" ignoremask="0xFF">0x00</Byte>
        <Byte order="2" ignoremask="0xFF">0x00</Byte>
      </Telegram>
      <RealData>
        <Data>
        <Shortcut>CHA</Shortcut>
        <Type>Channel</Type>
        <Value>255</Value>
       </Data>     
      </RealData>
     </Dataset>
    </Step>
    </Test>
  </TestCase>
  
  <TestCase>
  <Name>Level of material Tests</Name>
   <Test>
    <Name>Min level material</Name>
    <Step>
     <Dataset>
      <Telegram rorg="0xD2" length="3">
        <Byte order="0" ignoremask="0xFF">0x00</Byte>
        <Byte order="1" ignoremask="0x00">0x00</Byte>
        <Byte order="2" ignoremask="0xFF">0x00</Byte>
      </Telegram>
      <RealData>
       <Data>
        <Shortcut>LVL</Shortcut>
        <Type>Level</Type>  
        <Value>0</Value> 
       </Data>	   
      </RealData>
     </Dataset>
    </Step>
    </Test>
    
    <Test>
    <Name>Midian Level material</Name>
    <Step>
     <Dataset>
      <Telegram rorg="0xD2"  length="3">
        <Byte order="0" ignoremask="0xFF">0x00</Byte>
        <Byte order="1" ignoremask="0x00">0x32</Byte>
        <Byte order="2" ignoremask="0xFF">0x00</Byte>
      </Telegram>
      <RealData>
       <Data>
        <Shortcut>lvl</Shortcut> 
        <Type>LEVEL</Type>   
        <Value>50</Value>
       </Data>	   
      </RealData>
     </Dataset>
    </Step>
    </Test>

    <Test>
    <Name>Max level material</Name>
    <Step>
     <Dataset>
      <Telegram rorg="0xD2" length="3">
        <Byte order="0" ignoremask="0xFF">0x00</Byte>
        <Byte order="1" ignoremask="0x00">0x64</Byte>
        <Byte order="2" ignoremask="0xFF">0x00</Byte>
      </Telegram>
      <RealData>
        <Data>
        <Shortcut>lvl</Shortcut>
        <Type>level</Type>
        <Value>100</Value>
       </Data>	   
      </RealData>
     </Dataset>
    </Step>
    </Test>
    </TestCase>
   
  <TestCase>
    <Name>Error code Test</Name>
    <Test>
    <Name>No error Test</Name>
    <Step>
     <Dataset>
      <Telegram rorg="0xD2" length="3">
        <Byte order="0" ignoremask="0xFF">0x00</Byte>
