<?xml version="1.0" encoding="utf-8"?>
<ProfileCertification xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./Certification_EEP.xsd" schemaVersion="0.9">
  <EEP rorg="0xA5" func="0x30" type="0x05">
    <TestCase>
      <Name>Teach-in Test</Name>
      <Test>
        <Name>Unidirectional Teach-in Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0x0">0xC0</Byte>
              <Byte order="1" ignoremask="0x07">0x28</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0x00">0x80</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>LRN Bit</Type>
                <Value>0</Value>
              </Data>
              <Data>
                <Type>RORG</Type>
                <Value>165</Value>
              </Data>
              <Data>
                <Type>FUNC</Type>
                <Value>48</Value>
              </Data>
              <Data>
                <Type>TYPE</Type>
                <Value>5</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>Supply voltage Tests</Name>
      <Test>
        <Name>Min Supply voltage Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0x00">0x00</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xF7">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>VDD</Shortcut>
                <Type>Supply voltage</Type>
                <Value>0</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Max Supply voltage Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0x00">0xFF</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xF7">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>VDD</Shortcut>
                <Type>Supply voltage</Type>
                <Value>33</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Mid Supply voltage Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0x00">0x7F</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xF7">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>VDD</Shortcut>
                <Type>Supply voltage</Type>
                <Value>16.5</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>Signal type Enum Test</Name>
      <Test>
        <Name>Signal type: Normal signal</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0x7F">0x00</Byte>
              <Byte order="3" ignoremask="0xF7">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>ST</Shortcut>
                <Type>Normal signal</Type>
                <Value>0</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Signal type: Heart beat signal</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0x7F">0x80</Byte>
              <Byte order="3" ignoremask="0xF7">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>ST</Shortcut>
                <Type>Heart beat signal</Type>
                <Value>1</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>Index of Signals Enum Test</Name>
      <Test>
        <Name>Index of Signals: Increment a counter by new telegram</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0x80">0x7F</Byte>
              <Byte order="3" ignoremask="0xF7">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>IOS</Shortcut>
                <Type>Increment a counter by new telegram</Type>
                <Value>127</Value>
              </Data>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>unusedFieldTest</Name>
      <Test>
        <Name>unused field test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xA5" length="4">
              <Byte order="0" ignoremask="0x00">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xFF">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>LRN</Shortcut>
                <Type>LRN Bit</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
  </EEP>
</ProfileCertification>