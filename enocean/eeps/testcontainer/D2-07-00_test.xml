<?xml version="1.0" encoding="utf-8"?>
<ProfileCertification xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:noNamespaceSchemaLocation="./Certification_EEP.xsd"  schemaVersion="0.9">
	<EEP rorg="0xD2"	func="0x07"	type="0x00">
	<TestCase>
    <Name>Teach-in Test</Name>
    <Test>
        <Name>Unidirectional Teach-in Test</Name>
        <Step>
            <Dataset>
	<Telegram rorg="0xD4" length="7">
	<Byte order="0" ignoremask="0xFF">0x80</Byte>
	<Byte order="1" ignoremask="0xFF">0x00</Byte>
	<Byte order="2" ignoremask="0xFF">0x00</Byte>
	<Byte order="3" ignoremask="0xFF">0x00</Byte>
	<Byte order="4" ignoremask="0x00">0x00</Byte>
	<Byte order="5" ignoremask="0x00">0x07</Byte>
	<Byte order="6" ignoremask="0x00">0xD2</Byte>
	</Telegram>
	<RealData>
    <Data>
        <Type>RORG</Type>
        <Value>0xD2</Value>
    </Data>
    <Data>
        <Type>FUNC</Type>
        <Value>0x07</Value>
    </Data>
    <Data>
        <Type>TYPE</Type>
        <Value>0x00</Value>
    </Data>
    </RealData>
    </Dataset>
    </Step>
    </Test>
    </TestCase>
	<TestCase>
	<Name>Bold state</Name>
		<Test>
		<Name> Bold inside the lock1 Bold state Test</Name>
		<Step>
		<DataSet>
		<Telegram rorg="0xD2" length="1">
	<Byte order="0" ignoremask="0x7F">0x0</Byte>
	</Telegram>
            <RealData>
              <Data>
                <Type>Bold state</Type>
                <Value>0x0</Value>
              </Data>
            </RealData>
          </DataSet>
            </Step>
            </Test>
	</TestCase>
	<TestCase>
	<Name>Catch state</Name>
		<Test>
		<Name> Catch inside the lock1 Catch state Test</Name>
		<Step>
		<DataSet>
		<Telegram rorg="0xD2" length="1">
	<Byte order="0" ignoremask="0xBF">0x0</Byte>
	</Telegram>
            <RealData>
              <Data>
                <Type>Catch state</Type>
                <Value>0x0</Value>
              </Data>
            </RealData>
          </DataSet>
            </Step>
            </Test>
	</TestCase>
	<TestCase>
      <Name>unusedFieldTest</Name>
      <Test>
        <Name>unused field test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xD2" length="1">
	<Byte order="0" ignoremask="0xFF">0x00</Byte>
	</Telegram>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
	</EEP>
