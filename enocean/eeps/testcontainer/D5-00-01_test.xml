<?xml version="1.0" encoding="utf-8"?>
<ProfileCertification xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./Certification_EEP.xsd" schemaVersion="0.9">
  <EEP rorg="0xD5" func="0x00" type="0x01" >
    <TestCase>
      <Name>Teach-in Test</Name>
      <Test>
        <Name>Unidirectional Teach-in Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xD5" length="1">
              <Byte order="0" ignoremask="0x01">0x00</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>LRN Bit</Type>
                <Value>0</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>Contact Tests</Name>
      <Test>
        <Name>Open Contact Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xD5" length="1">
              <Byte order="0" ignoremask="0x00">0x08</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>CT</Shortcut>
                <Type>Contact</Type>
                <Value>0x08</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Close Contact Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xD5" length="1">
              <Byte order="0" ignoremask="0x00">0x09</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Shortcut>CT</Shortcut>
                <Type>Contact</Type>
                <Value>0x09</Value>
              </Data>
 
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>unusedFieldTest</Name>
      <Test>
        <Name>unused field test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xD5" length="1">
              <Byte order="0" ignoremask="0x09">0x00</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>test</Type>
                <Value>0</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
  </EEP>
</ProfileCertification>
