                            <Byte order="5" ignoremask="0x00">0x32</Byte>
                            <Byte order="6" ignoremask="0x00">0xD2</Byte>
                        </Telegram>
                        <RealData>
                            <Data>
                                <Type>Direction</Type>
                                <Value>0</Value>
                            </Data>
                            <Data>
                                <Type>RORG</Type>
                                <Value>210</Value>
                            </Data>
                            <Data>
                                <Type>FUNC</Type>
                                <Value>50</Value>
                            </Data>
                            <Data>
                                <Type>TYPE</Type>
                                <Value>02</Value>
                            </Data>
                        </RealData>
                    </DataSet>
                </Step>
            </Test>
        </TestCase>
