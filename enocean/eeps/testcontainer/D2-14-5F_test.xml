						<RealData>
							<Data>
								<Type>RORG</Type>
								<Value>0xD2</Value>
							</Data>
							<Data>
								<Type>FUNC</Type>
								<Value>0x14</Value>
							</Data>
							<Data>
								<Type>TYPE</Type>
								<Value>0x5F</Value>
							</Data>
						</RealData>
					</Dataset>
				</Step>
			</Test>
		</TestCase>
