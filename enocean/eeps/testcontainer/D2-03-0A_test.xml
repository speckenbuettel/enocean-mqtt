<?xml version="1.0" encoding="utf-8"?>
<ProfileCertification
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./Certification_EEP.xsd" schemaVersion="0.9">
    <EEP rorg="0xD2" func="0x03" type="0x0A">
        <TestCase>
            <Name>Teach-in Test</Name>
            <Test>
                <Name>Universal Teach-in Test</Name>
                <Step>
                    <DataSet>
                        <Telegram rorg="0xD4" length="7">
                            <!--UTE-->
                            <Byte order="0" ignoremask="0x00">0x60</Byte>
                            <Byte order="1" ignoremask="0x00">0x01</Byte>
                            <Byte order="2" ignoremask="0xFF">0x46</Byte>
                            <Byte order="3" ignoremask="0xFF">0x00</Byte>
                            <Byte order="4" ignoremask="0x00">0x0A</Byte>
                            <Byte order="5" ignoremask="0x00">0x03</Byte>
                            <Byte order="6" ignoremask="0x00">0xD2</Byte>
                        </Telegram>
                        <RealData>
                            <Data>
                                <Type>Direction</Type>
                                <Value>0</Value>
                            </Data>
                            <Data>
                                <Type>RORG</Type>
                                <Value>210</Value>
                            </Data>
                            <Data>
                                <Type>FUNC</Type>
                                <Value>3</Value>
                            </Data>
                            <Data>
                                <Type>TYPE</Type>
                                <Value>10</Value>
                            </Data>
                        </RealData>
                    </DataSet>
                </Step>
            </Test>
        </TestCase>
        <TestCase>
            <Name>Battery Autonomy</Name>
            <Test>
                <Name> Min Battery Autonomy</Name>
                <Step>
                    <DataSet>
                        <Telegram rorg="0xD2" length="2">
                            <Byte order="0" ignoremask="0x00">0x01</Byte>
                            <Byte order="1" ignoremask="0xFF">0x00</Byte>
                        </Telegram>
                        <RealData>
                            <Data>
                                <Type>BATT</Type>
                                <Value>1</Value>
                            </Data>
                        </RealData>
                    </DataSet>
                </Step>
            </Test>
            <Test>
                <Name> Max Battery Autonomy</Name>
                <Step>
                    <DataSet>
                        <Telegram rorg="0xD2" length="2">
                            <Byte order="0" ignoremask="0x00">0x64</Byte>
                            <Byte order="1" ignoremask="0xFF">0x00</Byte>
                        </Telegram>
                        <RealData>
                            <Data>
                                <Type>BATT</Type>
                                <Value>100</Value>
                            </Data>
                        </RealData>
                    </DataSet>
                </Step>
            </Test>
            <Test>
                <Name> Mid Battery Autonomy</Name>
                <Step>
                    <DataSet>
                        <Telegram rorg="0xD2" length="2">
                            <Byte order="0" ignoremask="0x00">0x32</Byte>
                            <Byte order="1" ignoremask="0xFF">0x00</Byte>
                        </Telegram>
                        <RealData>
                            <Data>
                                <Type>BATT</Type>
                                <Value>50</Value>
                            </Data>
                        </RealData>
                    </DataSet>
                </Step>
            </Test>
        </TestCase>
        <TestCase>
            <Name>Buttun action</Name>
            <Test>
                <Name> Simple Press</Name>
                <Step>
                    <DataSet>
                        <Telegram rorg="0xD2" length="2">
                            <Byte order="0" ignoremask="0xFF">0x00</Byte>
                            <Byte order="1" ignoremask="0x00">0x01</Byte>
                        </Telegram>
                        <RealData>
                            <Data>
                                <Type>BA</Type>
                                <Value>1</Value>
                            </Data>
                        </RealData>
                    </DataSet>
                </Step>
            </Test>
            <Test>
                <Name> Double press</Name>
                <Step>
                    <DataSet>
                        <Telegram rorg="0xD2" length="2">
                            <Byte order="0" ignoremask="0xFF">0x00</Byte>
                            <Byte order="1" ignoremask="0x00">0x02</Byte>
                        </Telegram>
                        <RealData>
                            <Data>
                                <Type>BA</Type>
                                <Value>2</Value>
                            </Data>
                        </RealData>
                    </DataSet>
                </Step>
            </Test>
            <Test>
                <Name> Long press</Name>
                <Step>
                    <DataSet>
                        <Telegram rorg="0xD2" length="2">
                            <Byte order="0" ignoremask="0xFF">0x00</Byte>
                            <Byte order="1" ignoremask="0x00">0x03</Byte>
                        </Telegram>
                        <RealData>
                            <Data>
                                <Type>BA</Type>
                                <Value>3</Value>
                            </Data>
                        </RealData>
                    </DataSet>
                </Step>
            </Test>
            <Test>
                <Name> Long press release</Name>
                <Step>
                    <DataSet>
                        <Telegram rorg="0xD2" length="2">
                            <Byte order="0" ignoremask="0xFF">0x00</Byte>
                            <Byte order="1" ignoremask="0x00">0x04</Byte>
                        </Telegram>
                        <RealData>
                            <Data>
                                <Type>BA</Type>
                                <Value>4</Value>
                            </Data>
                        </RealData>
                    </DataSet>
                </Step>
            </Test>
        </TestCase>
    </EEP>
</ProfileCertification>