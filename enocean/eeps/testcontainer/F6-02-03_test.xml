<?xml version="1.0" encoding="utf-8"?>
<ProfileCertification
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./Certification_EEP.xsd" schemaVersion="0.9">
  <EEP rorg="0xF6" func="0x02" type="0x03">
    <TestCase>
      <Name>Rocker action Enum Test</Name>
      <Test>
        <Name>Button A0</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xF6" length="1" status="0x30">
              <Byte order="0" ignoremask="0x00">0x30</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>Button A0: Set the controller in automatic mode</Type>
                <Value>48</Value>
              </Data>
              <Data>
                <Type>Status</Type>
                <Value>30</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Button A1</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xF6" length="1">
              <Byte order="0" ignoremask="0x00">0x10</Byte>
            </Telegram>
            <ShortCut>R1</ShortCut>
            <RealData>
              <Data>
                <Type>Button A1: Set the controller in manually mode and toggles betweenswitch light on and switch light off</Type>
                <Value>16</Value>
              </Data>
              <Data>
                <Type>Status</Type>
                <Value>30</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Button B0</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xF6" length="1">
              <Byte order="0" ignoremask="0x00">0x70</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>Button B0: Dim light up</Type>
                <Value>112</Value>
              </Data>
              <Data>
                <Type>Status</Type>
                <Value>30</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
      <Test>
        <Name>Button B1</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xF6" length="1">
              <Byte order="0" ignoremask="0x00">0x50</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>Button B1: Dim light down</Type>
                <Value>80</Value>
              </Data>
              <Data>
                <Type>Status</Type>
                <Value>30</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>Press test</Name>
      <Test>
        <Name>Press Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xF6" length="1">
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>Button pressed</Type>
                <Value>80</Value>
              </Data>
              <Data>
                <Type>Status</Type>
                <Value>30</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
  </EEP>
</ProfileCertification>