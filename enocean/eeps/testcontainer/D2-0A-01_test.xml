  <EEP rorg="0xD2" func="0x0A" type="0x01">
    <TestCase>
      <Name>Teach-in Test</Name>
      <Test>
        <Name>Universal Teach-in Test</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xD4" length="7">
              <!--UTE-->
              <Byte order="0" ignoremask="0xFF">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xFF">0x00</Byte>
              <Byte order="4" ignoremask="0x00">0x01</Byte>
              <Byte order="5" ignoremask="0x00">0x0A</Byte>
              <Byte order="6" ignoremask="0x00">0xD2</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>Direction</Type>
                <Value>0</Value>
              </Data>
              <Data>
                <Type>RORG</Type>
                <Value>210</Value>
              </Data>
              <Data>
                <Type>FUNC</Type>
                <Value>10</Value>
              </Data>
              <Data>
                <Type>TYPE</Type>
                <Value>01</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
    <TestCase>
      <Name>Battery Life Test</Name>
      <Test>
        <Name> Battery OK</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xD2" length="4">
              <Byte order="0" ignoremask="0x00">0x00</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xFF">0x00</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>BatteryLife</Type>
                <Value>0</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
       <Test>
        <Name> Battery LOW</Name>
        <Step>
          <DataSet>
            <Telegram rorg="0xD2" length="4">
              <Byte order="0" ignoremask="0x00">0x80</Byte>
              <Byte order="1" ignoremask="0xFF">0x00</Byte>
              <Byte order="2" ignoremask="0xFF">0x00</Byte>
              <Byte order="3" ignoremask="0xFF">0x00</Byte>
            </Telegram>
            <RealData>
              <Data>
                <Type>BatteryLife</Type>
                <Value>1</Value>
              </Data>
            </RealData>
          </DataSet>
        </Step>
      </Test>
    </TestCase>
